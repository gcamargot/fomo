# ==============================================================================
# FOMO Security Analysis Suite - Environment Configuration
# ==============================================================================

# Daemon Operation Settings
SCANNER_CHAINS=base,arbitrum,ethereum,solana
SCANNER_INTERVAL=60
DORMANT_INTERVAL=120

# RPC Endpoints (Optional overrides for default public endpoints)
BASE_RPC_URL=https://mainnet.base.org
ETHEREUM_RPC_URL=https://cloudflare-eth.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Block Explorer API Keys (Optional - Blockscout REST API works without keys)
BASESCAN_API_KEY=
ETHERSCAN_API_KEY=
ARBISCAN_API_KEY=
OPTIMISTIC_API_KEY=
POLYGONSCAN_API_KEY=
BSCSCAN_API_KEY=

# AI Triage Agent Settings (Optional - if using Ollama worker)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=triage-agent
